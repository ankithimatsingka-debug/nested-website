# Cache static, fingerprinted assets aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# JavaScript/CSS bundles (often fingerprinted)
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Images & fonts
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# HTML should be revalidated so users get the latest deploy
/
  Cache-Control: public, max-age=0, must-revalidate
/*
  Cache-Control: public, max-age=0, must-revalidate
